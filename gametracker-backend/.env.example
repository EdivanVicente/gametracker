# Renomeie este arquivo para ".env" e preencha com valores reais

# Gere uma chave forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua_secret_key_aqui

# Deixe como está para desenvolvimento (SQLite) ou aponte para o Postgres em produção
DATABASE_URL=sqlite:///./gametracker.db

# Obtenha em https://rawg.io/apidocs
RAWG_API_KEY=sua_rawg_api_key_aqui

# --- Provedor RESERVA de dados de jogos (IGDB) ---
IGDB_CLIENT_ID=seu_igdb_client_id_aqui
IGDB_CLIENT_SECRET=seu_igdb_client_secret_aqui

# Obtenha no Google Cloud Console (YouTube Data API v3)
YOUTUBE_API_KEY=sua_youtube_api_key_aqui

# URL onde o FRONTEND está acessível
FRONTEND_BASE_URL=http://127.0.0.1:5500/gametracker-frontend

# --- Configurações de E-mail (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_aplicativo_aqui
SMTP_FROM=seu_email@gmail.com
SMTP_USE_TLS=true