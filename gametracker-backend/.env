# Renomeie este arquivo para ".env" e preencha com valores reais

# Gere uma chave forte, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dfcae898d730dfc18e44448c482dd631479471419b258e6e8ed8e3904215c441

# Deixe como está para desenvolvimento (SQLite) ou aponte para o Postgres em produção
DATABASE_URL=sqlite:///./gametracker.db

# Obtenha em https://rawg.io/apidocs
RAWG_API_KEY=4b2d444721e749f59a697d1d4806c19f

# Obtenha no Google Cloud Console (YouTube Data API v3)
YOUTUBE_API_KEY=

# URL onde o FRONTEND está acessível — usada nos links de e-mail (confirmação,
# redefinir senha) e no botão "Ir para o login" da página de verificação.
# Se você abre a pasta "gametracker" (pai) no VS Code e usa o Live Server nela,
# o servidor serve a partir dessa pasta pai — então o frontend fica em
# "/gametracker-frontend/", não na raiz. Ajuste essa linha conforme o seu setup:
#   - Rodando com iniciar_frontend.bat (python -m http.server dentro de gametracker-frontend): http://127.0.0.1:5500
#   - Live Server com a pasta "gametracker" (pai) aberta no VS Code:            http://127.0.0.1:5500/gametracker-frontend
#   - Live Server com a pasta "gametracker-frontend" aberta diretamente:        http://127.0.0.1:5500
FRONTEND_BASE_URL=http://127.0.0.1:5500/gametracker-frontend
